{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "custom-elements.json", "storybook-static/**"]
    },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "typecheck": { "dependsOn": ["^build"] },
    "size": { "dependsOn": ["build"] },
    "dev": { "cache": false, "persistent": true }
  }
}
