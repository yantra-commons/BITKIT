{
  "name": "@orange-ui/elements",
  "version": "0.1.0",
  "description": "Framework-agnostic Bitcoin + Lightning web components (Lit).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "customElements": "custom-elements.json",
  "sideEffects": [
    "./dist/index.js",
    "./dist/components/**/*.js",
    "./dist/cdn/*.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./internal/*": {
      "types": "./dist/internal/*.d.ts",
      "default": "./dist/internal/*.js"
    },
    "./cdn": "./dist/cdn/orange-ui.js",
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.stories.*",
    "custom-elements.json"
  ],
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "build": "tsc -p tsconfig.build.json && vite build && cem analyze",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet"
  },
  "dependencies": {
    "@orange-ui/adapters": "workspace:*",
    "@orange-ui/core": "workspace:*",
    "@orange-ui/tokens": "workspace:*",
    "lit": "^3.3.3",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@bitcoin-design/bitcoin-icons-svg": "^0.1.11",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@storybook/web-components": "^10.6.7",
    "@storybook/web-components-vite": "^10.6.7",
    "storybook": "^10.6.7",
    "vite": "^8.3.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yantra-commons/BITKIT",
    "directory": "packages/elements"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "bitcoin",
    "lightning",
    "web-components",
    "lit",
    "checkout",
    "wallet",
    "ui-kit"
  ],
  "homepage": "https://bitkit.dvsv2004.workers.dev/",
  "bugs": {
    "url": "https://github.com/yantra-commons/BITKIT/issues"
  }
}
