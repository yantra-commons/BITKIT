{
  "$description": "Source of truth for orange-ui design tokens. Theme-independent tokens live under 'base'; color tokens per theme under 'themes'. Every key becomes --ou-<group>-<name>.",
  "base": {
    "font": {
      "sans": "\"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
      "mono": "ui-monospace, \"SFMono-Regular\", \"JetBrains Mono\", Menlo, Consolas, monospace"
    },
    "font-size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.5rem",
      "2xl": "2rem"
    },
    "font-weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "line-height": {
      "tight": "1.2",
      "normal": "1.5"
    },
    "space": {
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem"
    },
    "radius": {
      "sm": "6px",
      "md": "10px",
      "lg": "16px",
      "full": "9999px"
    },
    "control-height": {
      "sm": "2rem",
      "md": "2.5rem",
      "lg": "3rem"
    },
    "duration": {
      "fast": "120ms",
      "normal": "220ms",
      "slow": "400ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "z": {
      "dialog": "1000",
      "toast": "1100",
      "tooltip": "1200"
    }
  },
  "themes": {
    "light": {
      "color": {
        "bg": "#FFFFFF",
        "surface": "#FFFFFF",
        "surface-2": "#F5F5F7",
        "surface-3": "#EBEBEF",
        "border": "#D4D4DA",
        "border-strong": "#8E8E99",
        "text": "#16161A",
        "text-muted": "#55555F",
        "accent": "#F7931A",
        "accent-hover": "#E2840F",
        "on-accent": "#16161A",
        "accent-text": "#A65800",
        "success": "#147A38",
        "success-bg": "#E6F5EC",
        "warning": "#875700",
        "warning-bg": "#FFF4DB",
        "danger": "#B91C24",
        "danger-bg": "#FDECEC",
        "info": "#1D5BB8",
        "info-bg": "#E8F0FC",
        "overlay": "rgba(10, 10, 14, 0.55)",
        "focus": "#1D5BB8",
        "qr-fg": "#000000",
        "qr-bg": "#FFFFFF"
      },
      "shadow": {
        "sm": "0 1px 2px rgba(16, 16, 24, 0.08)",
        "md": "0 4px 16px rgba(16, 16, 24, 0.10)",
        "lg": "0 16px 48px rgba(16, 16, 24, 0.18)"
      }
    },
    "dark": {
      "color": {
        "bg": "#0E0E11",
        "surface": "#17171C",
        "surface-2": "#1F1F26",
        "surface-3": "#2A2A33",
        "border": "#33333D",
        "border-strong": "#6E6E7A",
        "text": "#F3F3F6",
        "text-muted": "#A3A3AE",
        "accent": "#F7931A",
        "accent-hover": "#FFA640",
        "on-accent": "#16161A",
        "accent-text": "#FFA640",
        "success": "#4ADE80",
        "success-bg": "#0F2A1A",
        "warning": "#FBBF24",
        "warning-bg": "#2D2208",
        "danger": "#F87171",
        "danger-bg": "#2E1214",
        "info": "#7AB4FF",
        "info-bg": "#0F1D33",
        "overlay": "rgba(0, 0, 0, 0.7)",
        "focus": "#7AB4FF",
        "qr-fg": "#000000",
        "qr-bg": "#FFFFFF"
      },
      "shadow": {
        "sm": "0 1px 2px rgba(0, 0, 0, 0.4)",
        "md": "0 4px 16px rgba(0, 0, 0, 0.45)",
        "lg": "0 16px 48px rgba(0, 0, 0, 0.6)"
      }
    }
  },
  "contrastPairs": [
    ["text", "bg", 4.5],
    ["text", "surface", 4.5],
    ["text", "surface-2", 4.5],
    ["text-muted", "bg", 4.5],
    ["text-muted", "surface", 4.5],
    ["text-muted", "surface-2", 4.5],
    ["on-accent", "accent", 4.5],
    ["on-accent", "accent-hover", 4.5],
    ["accent-text", "bg", 4.5],
    ["accent-text", "surface", 4.5],
    ["success", "bg", 4.5],
    ["success", "success-bg", 4.5],
    ["warning", "bg", 4.5],
    ["warning", "warning-bg", 4.5],
    ["danger", "bg", 4.5],
    ["danger", "danger-bg", 4.5],
    ["info", "bg", 4.5],
    ["info", "info-bg", 4.5],
    ["border-strong", "bg", 3],
    ["focus", "bg", 3],
    ["qr-fg", "qr-bg", 7]
  ]
}
