---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Aside, Code } from '@astrojs/starlight/components';
import Demo from '../../../components/Demo.astro';
import { components, type ComponentDoc } from '../../../lib/manifest';
import { examples } from '../../../lib/examples';

export function getStaticPaths() {
  return components.filter((c) => c.tag !== 'bk-toaster').map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: ComponentDoc };
const example = examples[c.slug];
const payments = ['pay-button', 'checkout', 'donation-widget'].includes(c.slug);
const summary = c.summary.replace(/^SECURITY-SENSITIVE\.\s*/, '');
const typeText = (t?: { text?: string }) => (t?.text ?? '').replace(/\s*\|\s*undefined$/, '');
const strip = (s?: string) => (s ?? '').replace(/\s+/g, ' ').trim();
// Attribute rows plus property-only fields (objects, arrays) that have no attribute.
const attrFields = new Set(c.attributes.map((a) => a.fieldName ?? a.name));
const propOnly = c.properties.filter((p) => !attrFields.has(p.name) && p.name !== 'data');
const headings = [
  { depth: 2, slug: 'example', text: 'Example' },
  { depth: 2, slug: 'import', text: 'Import' },
  { depth: 2, slug: 'api', text: 'API' },
];
const reactName = c.name;
---

<StarlightPage frontmatter={{ title: `<${c.tag}>`, description: summary }} headings={headings}>
  <p>{summary}</p>
  {
    c.security && (
      <Aside type="caution" title="Security-sensitive component">
        This component handles recovery phrases. Words are memory-only: they are never written to attributes, storage, the
        network or events. Read the <a href={`${import.meta.env.BASE_URL}docs/guides/security/`}>security model</a> before using it.
      </Aside>
    )
  }

  <h2 id="example">Example</h2>
  {example ? <Demo slug={c.slug} example={example} payments={payments} /> : <p>See the API below.</p>}

  <h2 id="import">Import</h2>
  <Code
    lang="ts"
    code={`// Web component (registers <${c.tag}>)\nimport '@bitkit-ui/elements/${c.slug === 'toaster' ? 'toast' : c.slug}';\n\n// React\nimport { ${reactName} } from '@bitkit-ui/react';\n\n// Vue\nimport { ${reactName} } from '@bitkit-ui/vue';`}
  />

  <h2 id="api">API</h2>
  {
    (c.attributes.length > 0 || propOnly.length > 0) && (
      <>
        <h3>Properties &amp; attributes</h3>
        <table class="api-table">
          <thead>
            <tr><th>Attribute</th><th>Property</th><th>Type</th><th>Default</th><th>Description</th></tr>
          </thead>
          <tbody>
            {c.attributes.map((a) => (
              <tr>
                <td><code>{a.name}</code></td>
                <td><code>{a.fieldName ?? a.name}</code></td>
                <td><code>{typeText(a.type)}</code></td>
                <td>{a.default ? <code>{a.default}</code> : '—'}</td>
                <td>{strip(a.description)}</td>
              </tr>
            ))}
            {propOnly.map((p) => (
              <tr>
                <td>— <small>(property only)</small></td>
                <td><code>{p.name}</code></td>
                <td><code>{typeText(p.type)}</code></td>
                <td>{p.default ? <code>{p.default}</code> : '—'}</td>
                <td>{strip(p.description)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }
  {
    c.events.length > 0 && (
      <>
        <h3>Events</h3>
        <table class="api-table">
          <thead><tr><th>Event</th><th>React</th><th>Vue</th><th>Description</th></tr></thead>
          <tbody>
            {c.events.map((e) => {
              const suffix = e.name.replace(/^bk-/, '').replace(/(^|-)(\w)/g, (_m: string, _d: string, ch: string) => ch.toUpperCase());
              return (
                <tr>
                  <td><code>{e.name}</code></td>
                  <td><code>on{suffix}</code></td>
                  <td><code>@{e.name.replace(/^bk-/, '')}</code></td>
                  <td>{strip(e.description)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </>
    )
  }
  {
    c.methods.length > 0 && (
      <>
        <h3>Methods</h3>
        <table class="api-table">
          <thead><tr><th>Method</th><th>Description</th></tr></thead>
          <tbody>
            {c.methods.map((m) => (
              <tr>
                <td><code>{m.name}({(m.parameters ?? []).map((p) => p.name).join(', ')})</code></td>
                <td>{strip(m.description)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }
  {
    c.slots.length > 0 && (
      <>
        <h3>Slots</h3>
        <table class="api-table">
          <thead><tr><th>Slot</th><th>Description</th></tr></thead>
          <tbody>
            {c.slots.map((s) => (
              <tr><td><code>{s.name || '(default)'}</code></td><td>{strip(s.description)}</td></tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }
  {
    c.cssParts.length > 0 && (
      <>
        <h3>CSS parts</h3>
        <p>Style internals with <code>{`${c.tag}::part(name)`}</code>.</p>
        <table class="api-table">
          <thead><tr><th>Part</th><th>Description</th></tr></thead>
          <tbody>
            {c.cssParts.map((p) => (
              <tr><td><code>{p.name}</code></td><td>{strip(p.description)}</td></tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }
  <h3>CSS custom properties</h3>
  {
    c.cssProperties.length > 0 && (
      <table class="api-table">
        <thead><tr><th>Property</th><th>Description</th></tr></thead>
        <tbody>
          {c.cssProperties.map((p) => (
            <tr><td><code>{p.name}</code></td><td>{strip(p.description)}</td></tr>
          ))}
        </tbody>
      </table>
    )
  }
  <p>
    All components read the shared design tokens (<code>--bk-color-*</code>, <code>--bk-radius-*</code>, <code>--bk-font-*</code>…).
    See <a href={`${import.meta.env.BASE_URL}docs/guides/theming/`}>Theming</a> or try the
    <a href={`${import.meta.env.BASE_URL}theme-builder/`}>theme builder</a>.
  </p>
</StarlightPage>
