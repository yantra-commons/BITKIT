---
// Standalone layout for marketing pages (landing, templates). Docs use Starlight.
import kit from '../../../../kit.config.json';
import '@bitkit-ui/tokens/tokens.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  bare?: boolean;
}
const { title, description, bare = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = `${kit.siteUrl}${kit.siteBase}/og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0e0e11" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Share the docs theme preference (Starlight stores it as `starlight-theme`).
      (() => {
        let t = null;
        try {
          t = localStorage.getItem('starlight-theme');
        } catch {}
        const dark = t === 'dark' || ((!t || t === 'auto') && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.setAttribute('data-bk-theme', dark ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    {!bare && <a class="skip" href="#main">Skip to content</a>}
    {
      !bare && (
        <header class="nav">
          <div class="wrap nav__inner">
            <a class="brand" href={base} aria-label={`${kit.displayName} home`}>
              <img src={`${base}favicon.svg`} alt="" width="28" height="28" />
              <span>{kit.displayName}</span>
            </a>
            <nav aria-label="Main">
              <ul>
                <li><a href={`${base}docs/`}>Docs</a></li>
                <li><a href={`${base}docs/components/checkout/`}>Components</a></li>
                <li><a href={`${base}playground/`}>Playground</a></li>
                <li><a href={`${base}templates/`}>Templates</a></li>
              </ul>
            </nav>
            <div class="nav__actions">
              <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle dark mode">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z" /></svg>
              </button>
              <a class="gh" href={`https://github.com/${kit.repo}`} rel="noopener">
                <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" /></svg>
                <span>Star on GitHub</span>
              </a>
            </div>
          </div>
        </header>
      )
    }
    {bare ? <slot /> : <main id="main"><slot /></main>}
    {
      !bare && (
        <footer class="foot">
          <div class="wrap foot__inner">
            <p>
              <strong>{kit.displayName}</strong> is MIT-licensed open source. Built on the patterns of the{' '}
              <a href="https://bitcoin.design" rel="noopener">Bitcoin Design Guide</a> and icons from{' '}
              <a href="https://bitcoinicons.com" rel="noopener">Bitcoin Icons</a>.
            </p>
            <ul>
              <li><a href={`${base}docs/`}>Docs</a></li>
              <li><a href={`${base}docs/guides/security/`}>Security</a></li>
              <li><a href={`${base}docs/guides/accessibility/`}>Accessibility</a></li>
              <li><a href={`https://github.com/${kit.repo}`} rel="noopener">GitHub</a></li>
            </ul>
          </div>
        </footer>
      )
    }
    <script>
      const root = document.documentElement;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.getAttribute('data-bk-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-bk-theme', next);
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {
          /* private mode */
        }
      });
    </script>
  </body>
</html>
