---
// Wraps Starlight's ThemeProvider and mirrors its light/dark choice onto `data-bk-theme`,
// so the kit's components follow the docs theme toggle.
import Default from '@astrojs/starlight/components/ThemeProvider.astro';
---

<Default />
<script is:inline>
  (() => {
    const root = document.documentElement;
    const sync = () => root.setAttribute('data-bk-theme', root.dataset.theme === 'light' ? 'light' : 'dark');
    sync();
    new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
  })();
</script>
